{
  "account": "Liso7150",
  "suite_root": "D:/Colibri-Suite",
  "engine_root": "D:/Colibri",
  "models_root": "D:/colibri-models",
  "cache_root": "D:/.cache",
  "credits": [
    {"name": "Colibri engine", "upstream": "https://github.com/JustVugg/colibri", "role": "device-tiered MoE inference engine"},
    {"name": "AirLLM", "upstream": "https://github.com/lyogavin/airllm", "role": "layer-streamed inference and streamed LoRA training"}
  ],
  "repos": [
    {"concept": "engine", "repo": "Liso7150/colibri", "upstream": "JustVugg/colibri", "branch": "feat/local-inference-toolkit", "description": "Native engine checkout; c/coli, not a second pip-installed coli script."},
    {"concept": "core", "repo": "Liso7150/colibri-core", "branch": "main", "description": "Shared agent runtime; pyproject supplies fastapi, uvicorn, psutil and colibri-agent."},
    {"concept": "cli", "repo": "Liso7150/colibri-cli", "branch": "main", "description": "The only pip-installed coli CLI."},
    {"concept": "desktop", "repo": "Liso7150/colibri-code", "branch": "main", "description": "Electron desktop application."},
    {"concept": "coding-agent", "repo": "Liso7150/colibri-coding-agent", "branch": "main", "description": "Coding-agent web/PWA assets served by the shared core."},
    {"concept": "jetbrains", "repo": "Liso7150/colibri-jetbrains", "branch": "main", "description": "IDE integration; plugin packaging is a separate step."},
    {"concept": "installer", "repo": "Liso7150/colibri-installer", "branch": "main", "description": "Portable bootstrap entry point."},
    {"concept": "finetune", "repo": "Liso7150/colibri-finetune", "branch": "main", "description": "Optional AirLLM streamed LoRA training."}
  ],
  "features": {
    "inference": {"requires": ["engine", "core", "cli"], "description": "Local engine and command-line runtime."},
    "desktop": {"requires": ["engine", "core", "desktop", "coding-agent"], "description": "Electron desktop with shared agent and web UI."},
    "coding-agent": {"requires": ["engine", "core", "coding-agent"], "description": "Local inference plus shared coding-agent server and web UI."},
    "jetbrains": {"requires": ["engine", "core", "jetbrains"], "description": "Local engine and agent for the IDE plugin."},
    "npu": {"requires": ["core"], "pip": ["openvino"], "description": "Optional NPU embeddings, NOT native model decoding."},
    "fine-tune": {"requires": ["engine", "finetune"], "pip": ["airllm", "torch", "transformers", "accelerate", "safetensors", "huggingface_hub"], "description": "Explicit opt-in to large training dependencies."},
    "mobile": {"requires": ["core", "coding-agent"], "description": "Host the shared web PWA on a computer; Android/iOS connect as clients, no phone inference."},
    "installer": {"requires": ["installer"], "description": "Download the portable bootstrap itself."}
  }
}
